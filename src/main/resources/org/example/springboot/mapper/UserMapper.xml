<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springboot.mapper.UserMapper">
    <select id="selectByUsername" resultType="org.example.springboot.entity.User">
        select id,username,password,created_at from users where username=#{username}
    </select>

    <insert id="addUser">
        insert into users(username,password,created_at) values(#{username},#{password},#{createdAt})
    </insert>

    <delete id="deleteUser">
        delete from users where username = #{username}
    </delete>

    <update id="updateUser">
        update users set password=#{password} where username=#{username}
    </update>

</mapper>